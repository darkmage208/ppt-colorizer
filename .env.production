# Production Environment Variables
# Copy this file to .env and fill in the actual values

# Database Configuration
POSTGRES_DB=ppt_colorizer
POSTGRES_USER=ppt_user
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# JWT Security - MUST CHANGE IN PRODUCTION
SECRET_KEY=CHANGE_THIS_TO_A_VERY_SECURE_SECRET_KEY_AT_LEAST_32_CHARS

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-bucket-name.your-account-id.r2.cloudflarestorage.com

# Domain Configuration
DOMAIN=gabiosystems.com