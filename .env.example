# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ppt_colorizer

# Storage Configuration (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id  
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_URL=https://your-bucket-name.your-account-id.r2.cloudflarestorage.com

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Celery Configuration  
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Security
SECRET_KEY=your-very-secure-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CloudConvert API (for high-quality PDF conversion)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here

# Optional: Gotenberg URL (alternative PDF converter)
GOTENBERG_URL=http://localhost:3001