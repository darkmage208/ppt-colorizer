FROM python:3.11-slim

# Install minimal system dependencies (no LibreOffice for faster builds)
RUN apt-get update && apt-get install -y \
    postgresql-client \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Create a requirements file without reportlab for faster testing
RUN pip install --no-cache-dir fastapi uvicorn sqlalchemy psycopg2-binary alembic python-jose python-multipart passlib bcrypt pandas openpyxl python-pptx boto3 python-dotenv pydantic pydantic-settings email-validator celery redis Pillow

# Copy the application code
COPY . .

# Create non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Use reload for development
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]